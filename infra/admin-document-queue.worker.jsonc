{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "architech-admin-document-consumer",
  "account_id": "f8fcf42a91f7fbf1cb89022ead312069",
  "main": "../src/lib/document-delivery/queue-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": { "ENABLE_ADMIN_DOCUMENT_QUEUE_CONSUMER": "true" },
  "queues": {
    "consumers": [{
      "queue": "architech-admin-documents",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 1,
      "max_retries": 0,
      "dead_letter_queue": "architech-admin-documents-dlq"
    }]
  },
  "services": [{ "binding": "DESK", "service": "architech-wacrm" }],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
