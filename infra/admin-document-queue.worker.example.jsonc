{
  // REVIEW ONLY: no deploy/provision step is authorized. Never use production
  // resource names until backup, billing, data-location and staging review pass.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "review-required-admin-document-consumer-staging",
  "main": "../src/lib/document-delivery/queue-worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": { "ENABLE_ADMIN_DOCUMENT_QUEUE_CONSUMER": "false" },
  "queues": {
    "consumers": [{
      "queue": "review-required-admin-documents-staging",
      "max_batch_size": 1,
      "max_batch_timeout": 1,
      "max_concurrency": 1,
      "max_retries": 0,
      "dead_letter_queue": "review-required-admin-documents-dlq-staging"
    }]
  },
  "services": [{ "binding": "DESK", "service": "review-required-whatsapp-desk-staging" }],
  "observability": { "enabled": false }
  // ADMIN_DOCUMENT_WORKER_TOKEN: separate 32-byte hex secret binding, no defaults.
}
