{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "architech-wacrm",
  // Architech Labs WACRM only — do not deploy with a token from another account.
  "account_id": "f8fcf42a91f7fbf1cb89022ead312069",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "whatsapp.architechlabs.in",
      "custom_domain": true,
    },
  ],
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "ENABLE_ADMIN_DOCUMENT_DELIVERY": "true",
    "ENABLE_ADMIN_DOCUMENT_QUEUE": "true",
    "ADMIN_DOCUMENT_PAYLOAD_STORAGE": "supabase",
    "ADMIN_DOCUMENT_DELIVERY_ACCOUNT_ID": "90e47f37-19d5-4fb8-94f8-8c2df7599f7e",
  },
  "queues": {
    "producers": [{ "binding": "ADMIN_DOCUMENT_QUEUE", "queue": "architech-admin-documents" }],
  },
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
